# Bootstrap settings of the performance runner. Copy to performance-runner.env,
# fill in, and keep the filled file private. Everything else (targets, sign-in
# tokens, the plan of a run) is set in qym's Performance pages.

# Set by Compose. For an external platform, override QYM_PERFORMANCE_RUNNER_QYM_URL
# in the Compose environment; outside Compose, set QYM_URL here: qym's address,
# with the ingestion prefix (for example /ingestion) when one is deployed.
QYM_URL=

# The ID of the project whose runs this runner executes, not its slug
# (Performance → Runner shows it under "Connect a runner").
QYM_PROJECT_ID=

# A project API key from Project settings → API keys. A Manager must choose the
# same key on Performance → Runner: only that key receives the sign-in tokens.
QYM_API_KEY=

# The name this runner registers under. Keep it on every restart: a project has
# one runner, and a second name is refused.
RUNNER_KEY=performance-runner-1

# Display name on the Runner page (default: RUNNER_KEY), and where the load
# comes from, in words (optional).
RUNNER_NAME=
RUNNER_LOCATION=

# Path, inside the runner container, of a PEM file with the extra certificate
# authorities the runner should trust for qym and for the targets. Leave empty
# when both use publicly trusted certificates. With qym's Compose files leave it
# empty too and set QYM_PERFORMANCE_RUNNER_CA_BUNDLE (the file's path on the host)
# in the Compose environment: Compose mounts the file read-only and sets this.
RUNNER_CA_BUNDLE=
