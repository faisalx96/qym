# Enable the worker's live ingest publisher (also set by Compose).
QYM_LIVE_ENABLED=true

# Set by Compose. For an external platform, override QYM_LIVE_WORKER_QYM_URL
# in the Compose environment; outside Compose, set QYM_BASE_URL here.
QYM_BASE_URL=

# A project API key from Project settings → API keys; name it after the
# environment (for example, preprod). Keep the filled env file private.
QYM_API_KEY=

# The ID of the project that owns the API key, not its slug.
QYM_PROJECT_ID=

# Stable source key: reuse it on restart. Use a different key per worker/environment.
QYM_LIVE_SOURCE_KEY=worker-preprod

# Display name shown in the project's Live tab.
QYM_LIVE_SOURCE_NAME=

# Environment label shown with the source.
QYM_LIVE_ENVIRONMENT=preprod

# Control polling interval, seconds.
QYM_LIVE_CONTROL_POLL_S=10

# Path to the CA bundle mounted inside the worker container.
CA_BUNDLE=

# No Phoenix collector in the cluster: keep tracing off or the worker logs an export error every few seconds.
DISABLE_PHOENIX_TRACING=true

# Every other setting is managed on the Worker page in qym.
# QYM_LIVE_CHART_IMAGES=true  # managed in qym since 2b
# QYM_LIVE_CHART_IMAGE_MAX_BYTES=2097152  # managed in qym since 2b

# Optional, worker-side only (not managed in qym): HTTP timeout per push, seconds (default 10),
# and `full` (default) or `summary` turn detail.
# QYM_LIVE_TIMEOUT_SECONDS=10
# QYM_LIVE_DETAIL=full
